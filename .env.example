# AI Provider — set at least one
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Model selection (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o

# Token and retrieval tuning
# MAX_TOKENS=4096
# TOP_K_RETRIEVAL=12
# TOP_K_RERANKED=5

# CORS: comma-separated list of allowed frontend origins.
# Default covers Vite dev server (5173) and local production (8080).
# For deployment, add your production frontend URL here.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://your-app.example.com
